# Ignore all utilities and user-specific tasks in the .idea folder
.idea/**
# Except for these shared team settings
!.idea/runConfigurations/
!.idea/codeStyles/
!.idea/scopes/
!.idea/inspectionProfiles/
!.idea/vcs.xml
!.idea/misc.xml
!.idea/encodings.xml
!.idea/modules.xml

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/
